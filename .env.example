# WasenderAPI token — get from wasenderapi.com → API Keys
WASENDER_API_TOKEN=your_token_here

# Manager WhatsApp number (receives new booking alerts)
MANAGER_PHONE=+9647809471576

# Firebase — copy from your Firebase console → Project Settings → Web App
FIREBASE_API_KEY=your_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_DATABASE_ID=(default)
