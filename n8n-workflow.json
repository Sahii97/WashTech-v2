      "parameters": {
        "jsCode": "const d = $input.first().json.body || $input.first().json;\nconst isKu = d.language === 'ku';\n\nconst text = isKu\n  ? `🚗 شۆفێرەکەت لە ڕێگایە بۆ لات!\\n👨‍💼 شۆفێر: ${d.driverName}\\n🕐 کات: ${d.slot}\\nزوو دەگات. سوپاس بۆ هەڵبژاردنی WashTech! 🧼`\n  : `🚗 سائقك في الطريق إليك!\\n👨‍💼 السائق: ${d.driverName}\\n🕐 الوقت: ${d.slot}\\nسيصل قريباً. شكراً لاختيارك WashTech! 🧼`;\n\nreturn [{ json: { to: d.phone, text } }];"
      },
